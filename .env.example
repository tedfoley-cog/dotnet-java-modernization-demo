# Copy to .env (git-ignored) and fill in per environment. Never commit real values.

# Legacy .NET app (dotnet_source): full ADO.NET connection string read by OrderContext.
ORDERDB_CONNECTION_STRING=<sql-server-connection-string>

# Java target (java_target): Spring Boot datasource.
SPRING_DATASOURCE_URL=jdbc:<driver>://<host>:<port>/<database>
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>

# Local-only alternative for the Java target: in-memory H2. Leave SPRING_DATASOURCE_* unset
# when using it -- environment variables take precedence over application-dev.properties.
# SPRING_PROFILES_ACTIVE=dev
