@model IEnumerable<OrderManagement.Web.Models.Order>
@{
    ViewBag.Title = "Orders";
}

<h2>Orders</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Order #</th>
            <th>Customer</th>
            <th>Date</th>
            <th>Status</th>
            <th class="text-right">Grand Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderNumber</td>
                <td>@order.Customer.Name</td>
                <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                <td><span class="label label-default">@order.Status</span></td>
                <td class="text-right">@order.GrandTotal.ToString("C")</td>
                <td>@Html.ActionLink("Details", "Details", new { id = order.OrderId })</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No orders found.</p>
}
